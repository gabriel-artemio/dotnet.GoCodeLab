@model IEnumerable<gocodelab.Models.Aplicacao>

@{
    ViewBag.Title = "Histórico Vacinação";
    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

<h2>Histórico de Vacinação</h2>

<form method="get" action="@Url.Action("Index")" class="form-inline mb-3">
    <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome..." />
    <button type="submit" class="btn btn-primary">Buscar</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Limpar</a>
</form>
<br />

@if (!Model.Any())
{
    <div class="alert alert-warning">Nenhuma aplicação encontrada.</div>
}
else
{
    <table class="table table-striped">
        <tr>
            <th>Paciente</th>
            <th>Vacina</th>
            <th>Data de Aplicação</th>
            <th>Dose (Número Dose)</th>
            <th>Unidade Aplicação</th>
            <th>Profissional Aplicador</th>
            <th>Ações</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.nm_paciente</td>
                <td>@item.nm_vacina</td>
                <td>@item.data_aplicacao.ToString("dd/MM/yyyy")</td>
                <td>@item.dose_numero</td>
                <td>@item.nm_unidade</td>
                <td>@item.nm_profissional</td>
                <td>
                    @Html.ActionLink("Editar", "Editar", new { id = item.cd_aplicacao }) |
                    @Html.ActionLink("Detalhes", "Detalhes", new { id = item.cd_aplicacao }) |
                    @Html.ActionLink("Excluir", "Excluir", new { id = item.cd_aplicacao })
                </td>
            </tr>
        }
    </table>

    <!-- Paginação -->
    <nav>
        <ul class="pagination">
            @if (paginaAtual > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { busca = ViewBag.Busca, pagina = paginaAtual - 1 })">« Anterior</a>
                </li>
            }

            @for (int i = 1; i <= totalPaginas; i++)
            {
                if (i == paginaAtual)
                {
                    <li class="page-item active"><span class="page-link">@i</span></li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { busca = ViewBag.Busca, pagina = i })">@i</a>
                    </li>
                }
            }

            @if (paginaAtual < totalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { busca = ViewBag.Busca, pagina = paginaAtual + 1 })">Próximo »</a>
                </li>
            }
        </ul>
    </nav>
}