@model gocodelab.Models.Paciente

@{
    ViewBag.Title = "Detalhes Paciente";
}

<h2>Detalhes do Paciente</h2>
@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Nome</label>
        @Html.TextBoxFor(m => m.nm_paciente, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>CPF</label>
        @Html.TextBoxFor(m => m.cpf, new { @class = "form-control" })
    </div>
    <a href="@Url.Action("Index", "Paciente")" class="btn btn-secondary">Voltar</a>
}